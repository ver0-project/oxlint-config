		"lint:fix": "vp lint --fix",
		"fmt": "vp fmt --write",
		"test": "vp test"
	},
	"devDependencies": {
		"conventional-changelog-conventionalcommits": "^10.4.0",
		"oxlint": "^1.80.0",
		"semantic-release": "^25.0.9",
		"typescript": "^7.0.2",
		"vite-plus": "^0.3.0",
		"vitest": "^4.1.11"
	},
	"peerDependencies": {
		"oxlint": "^1.80.0"
	},
	"peerDependenciesMeta": {
		"oxlint": {
			"optional": true
		}
	},
	"packageManager": "yarn@4.17.1"
